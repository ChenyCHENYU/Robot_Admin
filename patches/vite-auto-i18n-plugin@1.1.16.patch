+/*
+ * @Author: ChenYu ycyplus@gmail.com
+ * @Date: 2026-10-05
+ * @Description: Vite 查询模块、只读离线编译及有界缓存适配
+ * Copyright (c) 2026 by CHENY, All Rights Reserved 😎.
+ */
+import autoI18n, {
+  EmptyTranslator,
+  initOption,
+  FunctionFactoryOption,
+  filter,
+  translateUtils,
+} from './index.mjs'
+import { transformAsync } from '@babel/core'
+
+// 上游编译器使用模块级状态，串行化 AST 编译避免不同命名空间互相污染。
+let compilation = Promise.resolve()
+
+/** 不执行上游文件初始化；联网生成沿用原插件显式开启的生命周期。 */
+export function createI18nPlugin(options) {
+  const {
+    runtimeImport = '/lang/index.js',
+    cacheSize = 128,
+    ...input
+  } = options
+  const enabled =
+    typeof input.enabled === 'function'
+      ? input.enabled()
+      : input.enabled === true
+  const config = {
+    translateType: 'full-auto',
+    languageJsonMode: 'split',
+    isClearSpace: true,
+    deepScan: true,
+    rewriteConfig: false,
+    isClear: false,
+    buildToDist: false,
+    translator: new EmptyTranslator(),
+    excludedCall: ['import', 'console.debug'],
+    excludedPattern: [
+      /\.\w+$/,
+      /^[a-z_]+$/i,
+      /^\/.+\/[gimsuy]*$/,
+      /^https?:\/\//,
+      /^#[0-9a-f]{3,6}$/i,
+      /^\d+(\.\d+)?(px|em|rem|vh|vw|%)?$/,
+    ],
+    ...input,
+    enabled,
+  }
+  const plugin = enabled ? autoI18n(config) : { name: 'vite-auto-i18n-plugin' }
+  const upstream = plugin.transform
+  const cache = new Map()
+  // 保留官方公开工具读取配置的兼容性，无磁盘、网络和定时器副作用。
+  if (!enabled) {
+    initOption(config)
+    FunctionFactoryOption.originLang = config.originLang ?? 'zh-cn'
+    translateUtils.initLangObj({})
+  }
+  plugin.enforce = 'post'
+  /** 样式和业务数据不进入 Babel；无可翻译字符的模块直接跳过。 */
+  plugin.transform = async function (source, id, ...args) {
+    const file = id.split('?')[0].replace(/\\/g, '/')
+    if (
+      /\btype=style\b/.test(id) ||
+      ![
+        '.vue',
+        '.ts',
+        '.js',
+        '.tsx',
+        '.jsx',
+        ...(config.insertFileExtensions ?? []),
+      ].some((extension) => file.endsWith(extension))
+    )
+      return null
+    /** 配置正则即使带 g 标记也不能保留上一次匹配状态。 */
+    const matches = (pattern) => {
+      pattern.lastIndex = 0
+      return pattern.test(file)
+    }
+    if (config.includePath?.length && !config.includePath.some(matches))
+      return null
+    if (
+      (config.excludedPath ?? ['node_modules']).some((pattern) =>
+        typeof pattern === 'string' ? file.includes(pattern) : matches(pattern),
+      )
+    )
+      return null
+    if (
+      config.translateType === 'full-auto' &&
+      (config.originLang ?? 'zh-cn') === 'zh-cn' &&
+      !/[\u3400-\u9fff]|\\u(?:[\da-f]{4}|\{[\da-f]+\})/i.test(source)
+    )
+      return null
+    const cached = cache.get(id)
+    if (!enabled && cached?.source === source) return cached.result
+    let result
+    if (enabled) {
+      result = await upstream.call(this, source, file, ...args)
+      if (typeof result !== 'string') throw new Error(`国际化编译失败: ${id}`)
+      result =
+        result !== source
+          ? {
+              code: `import ${JSON.stringify(runtimeImport)};\n${result}`,
+              map: null,
+            }
+          : null
+    } else {
+      /** 每次编译绑定实例配置，等待 Babel 完成后再允许下一个实例进入。 */
+      const compile = async () => {
+        initOption(config)
+        FunctionFactoryOption.originLang = config.originLang ?? 'zh-cn'
+        translateUtils.initLangObj({})
+        const output = await transformAsync(source, {
+          configFile: false,
+          babelrc: false,
+          filename: file,
+          sourceMaps: true,
+          plugins: [filter.default()],
+        })
+        if (!Object.keys(translateUtils.getLangObj()).length) return null
+        if (!output?.code) throw new Error(`国际化编译失败: ${id}`)
+        if (output.map) output.map.mappings = ';' + output.map.mappings
+        return {
+          code: `import ${JSON.stringify(runtimeImport)};\n${output.code}`,
+          map: output.map,
+        }
+      }
+      const task = compilation.then(compile)
+      compilation = task.then(
+        () => undefined,
+        () => undefined,
+      )
+      result = await task
+      if (cacheSize > 0) {
+        if (cache.size >= cacheSize) cache.delete(cache.keys().next().value)
+        cache.set(id, { source, result })
+      }
+    }
+    return result
+  }
+  return plugin
+}
