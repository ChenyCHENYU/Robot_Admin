@@ -0,0 +1,237 @@
+/*
+ * @Author: ChenYu ycyplus@gmail.com
+ * @Date: 2026-10-05
+ * @Description: 框架无关的按需词典运行时；不导入 Node、Babel 或翻译 API
+ * Copyright (c) 2026 by CHENY, All Rights Reserved 😎.
+ */
+
+/** 与自动翻译编译器的 generateId 保持一致。 */
+export function getTranslationKey(text) {
+  const source = text.replace(/'/g, '"').replace(/\n/g, '\\n')
+  let hash = 0
+  for (let index = 0; index < source.length; index++) {
+    hash = ((hash << 5) - hash + source.charCodeAt(index)) | 0
+  }
+  return Math.abs(hash).toString(36) + source.length.toString(36)
+}
+
+/** 保留旧版语言别名，限制结果为当前项目支持的语言。 */
+export function normalizeLanguage(
+  value,
+  fallback = 'zh-cn',
+  languages = ['en', 'ja', 'ko'],
+) {
+  if (typeof value !== 'string') return fallback
+  const normalized = value.trim().toLowerCase().replace(/_/g, '-')
+  const aliases = {
+    'en-us': 'en',
+    'ja-jp': 'ja',
+    'ko-kr': 'ko',
+    'zh-cn': 'zh-cn',
+  }
+  const language = languages.includes(normalized)
+    ? normalized
+    : aliases[normalized]
+  return language === fallback || languages.includes(language)
+    ? language
+    : fallback
+}
+
+/** 工厂实例隔离词典和缓存，加载竞争只允许最新一次选择更新语言。 */
+export function createI18nRuntime(options) {
+  const {
+    namespace,
+    defaultLanguage = 'zh-cn',
+    languages = ['en', 'ja', 'ko'],
+    loaders = {},
+  } = options
+  const storageKey = options.storageKey ?? namespace
+  const cacheSize = Math.max(0, options.cacheSize ?? 512)
+  const pending = new Map()
+  const cache = new Map()
+  const warned = new Set()
+  let currentLanguage = defaultLanguage
+  let dictionary = {}
+  let requestVersion = 0
+  let loaded = false
+
+  /** 按需取得存储，隐私模式或 SSR 不会在模块导入时抛错。 */
+  const getStorage = () =>
+    options.storage ? options.storage() : globalThis.localStorage
+  /** 所有外部语言 key 都经过同一个入口归一化。 */
+  const normalize = (value) =>
+    normalizeLanguage(value, defaultLanguage, languages)
+  /** 读取兼容旧版本的原始字符串 key。 */
+  const getStoredLanguage = () => {
+    try {
+      return normalize(getStorage()?.getItem(storageKey))
+    } catch {
+      return defaultLanguage
+    }
+  }
+  /** 写入失败返回 false，让宿主决定是否刷新。 */
+  const persistLanguage = (language) => {
+    try {
+      const storage = getStorage()
+      if (!storage) return false
+      storage.setItem(storageKey, normalize(language))
+      return true
+    } catch {
+      return false
+    }
+  }
+  /** 只合并相同语言的在途请求；失败后允许重试。 */
+  const loadDictionary = (language) => {
+    if (pending.has(language)) return pending.get(language)
+    const promise = Promise.resolve()
+      .then(async () => {
+        const loader = loaders[language]
+        if (typeof loader !== 'function')
+          throw new Error(`Missing dictionary loader: ${language}`)
+        const result = await loader()
+        const value = result?.default ?? result
+        if (!value || typeof value !== 'object' || Array.isArray(value)) {
+          throw new TypeError(`Invalid dictionary: ${language}`)
+        }
+        return value
+      })
+      .finally(() => pending.delete(language))
+    pending.set(language, promise)
+    return promise
+  }
+  /** 回退路径也安全执行宿主回调，单个语言的异常最多提示一次。 */
+  const reportError = (error, language) => {
+    if (warned.has(language)) return
+    warned.add(language)
+    try {
+      if (options.onError) options.onError(error, language)
+      else
+        console.warn(
+          `[i18n:${namespace}] 语言资源加载失败，已使用 ${defaultLanguage}`,
+          error,
+        )
+    } catch {
+      /* 宿主日志回调不应阻塞应用启动。 */
+    }
+  }
+  /** 加载完成再提交状态，旧请求的成功或失败都不会覆盖新选择。 */
+  const initializeLanguage = async (value = getStoredLanguage()) => {
+    const version = ++requestVersion
+    const language = normalize(value)
+    if (loaded && language === currentLanguage) return
+    let nextDictionary = {}
+    let nextLanguage = language
+    try {
+      if (language !== defaultLanguage)
+        nextDictionary = await loadDictionary(language)
+    } catch (error) {
+      if (version !== requestVersion) return
+      nextLanguage = defaultLanguage
+      persistLanguage(defaultLanguage)
+      reportError(error, language)
+    }
+    if (version !== requestVersion) return
+    dictionary = nextDictionary
+    currentLanguage = nextLanguage
+    loaded = true
+    cache.clear()
+    if (typeof document !== 'undefined') {
+      document.documentElement.lang =
+        currentLanguage === 'zh-cn' ? 'zh-CN' : currentLanguage
+    }
+  }
+  /** 缓存有界，避免来自后端的动态文本长期累积。 */
+  const remember = (key, value) => {
+    if (cacheSize > 0) {
+      if (cache.size >= cacheSize) cache.delete(cache.keys().next().value)
+      cache.set(key, value)
+    }
+    return value
+  }
+  /** 缺失或格式错误的词条回退原文，保留相邻文本节点的空格。 */
+  const translateKey = (key, fallback, scope = namespace) => {
+    if (currentLanguage === defaultLanguage || scope !== namespace)
+      return fallback
+    const cacheKey = `${key}\0${fallback}`
+    if (cache.has(cacheKey)) return cache.get(cacheKey)
+    const source = fallback.trim()
+    const ownValue = Object.hasOwn(dictionary, key)
+      ? dictionary[key]
+      : undefined
+    const trimmedKey = source !== fallback ? getTranslationKey(source) : key
+    const value =
+      ownValue ||
+      (Object.hasOwn(dictionary, trimmedKey)
+        ? dictionary[trimmedKey]
+        : undefined)
+    if (typeof value !== 'string' || !value.trim())
+      return remember(cacheKey, fallback)
+    return remember(
+      cacheKey,
+      (fallback.match(/^\s*/)?.[0] ?? '') +
+        value.trim() +
+        (fallback.match(/\s*$/)?.[0] ?? ''),
+    )
+  }
+  /** 菜单等动态标题只计算一次 hash，不读存储、不扫描 DOM。 */
+  const translateText = (text) => {
+    if (currentLanguage === defaultLanguage) return text
+    const cacheKey = `\0${text}`
+    if (cache.has(cacheKey)) return cache.get(cacheKey)
+    return remember(
+      cacheKey,
+      translateKey(getTranslationKey(text.trim()), text),
+    )
+  }
+  /** 当前词典与 Naive UI 等宿主语言状态使用同一来源。 */
+  const getCurrentLanguage = () => currentLanguage
+  /** 安装命名空间分发器，多个应用不互相覆盖 $t。 */
+  const installGlobals = (target = globalThis) => {
+    const registryKey = Symbol.for('auto-i18n.runtime.registry')
+    let registry = target[registryKey]
+    if (!registry) {
+      registry = new Map()
+      Object.defineProperty(target, registryKey, {
+        value: registry,
+        configurable: true,
+      })
+      const previous = target.$t
+      /** 按编译器传入的命名空间找到对应运行时。 */
+      target.$t = (key, fallback, scope = namespace) => {
+        const instance = registry.get(scope)
+        return instance
+          ? instance.translateKey(key, fallback, scope)
+          : typeof previous === 'function'
+            ? previous(key, fallback, scope)
+            : fallback
+      }
+      /** 兼容原始全局切换协议，宿主可选择刷新以更新静态文案。 */
+      target.$changeLang = (language, scope = namespace) =>
+        registry.get(scope)?.initializeLanguage(language)
+    }
+    registry.set(namespace, runtime)
+    /** 原文标记保持纯函数，不监听 DOM 或创建响应式 watcher。 */
+    target.$$t ??= (value) => value
+    target.$deepScan ??= (value) => value
+    /** 兼容半角和历史翻译中的全角花括号。 */
+    target.$iS ??= (value, args) =>
+      typeof value === 'string' && Array.isArray(args)
+        ? value.replace(/\$(?:\{|｛)(\d+)(?:\}|｝)/g, (match, index) =>
+            args[Number(index)] !== undefined
+              ? String(args[Number(index)])
+              : match,
+          )
+        : value
+  }
+  const runtime = {
+    normalizeLanguage: normalize,
+    getStoredLanguage,
+    persistLanguage,
+    initializeLanguage,
+    getCurrentLanguage,
+    translateKey,
+    translateText,
+    installGlobals,
+  }
+  return runtime
+}
