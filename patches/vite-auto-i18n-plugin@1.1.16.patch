+import type { OptionInfo } from './index'
+import type { Plugin } from 'vite'
+export interface I18nPluginOptions extends OptionInfo {
+  /** 翻译模块依赖此入口，保证按需词典先于静态文案初始化。 */
+  runtimeImport?: string
+  /** 离线编译缓存的模块数量上限，0 为关闭缓存。 */
+  cacheSize?: number
+}
+/** 支持 Vite 8 Vue 查询模块的只读离线编译适配。 */
+export declare function createI18nPlugin(options: I18nPluginOptions): Plugin
