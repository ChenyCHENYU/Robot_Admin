+/** 与自动翻译编译器兼容的文本 hash。 */
+export declare function getTranslationKey(text: string): string
+export declare function normalizeLanguage<
+  L extends string = 'zh-cn' | 'en' | 'ja' | 'ko',
+>(value: unknown, fallback?: L, languages?: readonly L[]): L
+export interface I18nStorage {
+  getItem(key: string): string | null
+  setItem(key: string, value: string): void
+}
+export interface I18nRuntimeOptions<L extends string> {
+  namespace: string
+  storageKey?: string
+  defaultLanguage: L
+  languages: readonly L[]
+  loaders: Partial<Record<L, () => Promise<unknown>>>
+  storage?: () => I18nStorage | undefined
+  cacheSize?: number
+  onError?: (error: unknown, language: L) => void
+}
+export interface I18nRuntime<L extends string> {
+  normalizeLanguage(value: unknown): L
+  getStoredLanguage(): L
+  persistLanguage(language: L): boolean
+  initializeLanguage(language?: L): Promise<void>
+  getCurrentLanguage(): L
+  translateKey(key: string, fallback: string, namespace?: string): string
+  translateText(text: string): string
+  installGlobals(target?: object): void
+}
+/** 实例隔离、并发合并和有界缓存的按需词典运行时。 */
+export declare function createI18nRuntime<L extends string>(
+  options: I18nRuntimeOptions<L>,
+): I18nRuntime<L>
