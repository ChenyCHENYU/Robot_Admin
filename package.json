{
  "name": "robot-admin",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  },
  "description": "Robot 中后台管理系统团队架构模板 - 基于 Vue3 + Vite 的企业级中后台解决方案",
  "author": {
    "name": "ChenY",
    "email": "ycyplus@gmail.com",
    "url": "https://github.com/ChenyCHENYU"
  },
  "license": "MIT",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 env-manager dev && vite",
    "dev:local": "USE_LOCAL_PACKAGES=true bun run dev",
    "dev:components": "USE_LOCAL_COMPONENTS=true bun run dev",
    "dev:devtools": "VITE_DEVTOOLS=true bun run dev",
    "build": "env-manager prod && vite build",
    "build:test": "env-manager test && vite build --mode test --emptyOutDir",
    "build:staging": "env-manager staging && vite build --mode staging --profile",
    "preview": "bun run build && vite preview",
    "type-watch": "vue-tsc --noEmit --watch",
    "type-build": "vue-tsc --build tsconfig/tsconfig.app.json --force",
    "build:check": "bun run type-build && bun run build",
    "test": "bun test",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --no-fix --no-cache",
    "verify": "bun run lint:check && bun run lint:eslint && bun run type-build && bun run test && bun run build && bun run check:bundle",
    "check:bundle": "bun run scripts/check-bundle-budget.ts",
    "security:audit": "bun audit",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write src/",
    "prepare": "husky",
    "commit": "bun run cz",
    "check-branch": "gbd",
    "check-types": "ts-type-cleaner analyze",
    "gen:route-i18n": "bun run scripts/generate-route-translations.ts",
    "deploy": "bash ./scripts/merge-and-deploy.sh",
    "sync-deploy-branch": "bash ./scripts/sync-dev.sh",
    "analyze": "env-manager prod && ANALYZE=true vite build --mode analyze",
    "cz": "git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "mcp": "bun run mcp/server.ts"
  },
  "dependencies": {
    "@antv/x6": "^2.19.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/vue": "^5.0.0",
    "@robot-admin/directives": "2.0.1",
    "@robot-admin/file-utils": "3.0.1",
    "@robot-admin/form-validate": "2.0.0",
    "@robot-admin/git-standards": "1.0.4",
    "@robot-admin/layout": "2.3.2",
    "@robot-admin/naive-ui-components": "0.11.6",
    "@robot-admin/request-core": "0.2.0",
    "@robot-admin/theme": "0.4.0",
    "@splinetool/runtime": "^1.12.68",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "@visactor/vtable-gantt": "^1.23.3",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "motion-v": "^1.10.3",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "print-js": "^1.6.0",
    "robot-admin-env-manager": "^1.0.5",
    "vite-plugin-preloader": "^1.1.3",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@iconify-json/carbon": "^1.2.19",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.15",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.7.0",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "cz-customizable": "^7.5.1",
    "eslint": "^10.0.3",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-oxlint": "~1.52.0",
    "eslint-plugin-vue": "^10.8.0",
    "git-branch-check-diff-commits": "^1.2.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.2",
    "naive-ui": "^2.44.1",
    "oxlint": "~1.52.0",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.97.3",
    "ts-type-cleaner": "^5.0.8",
    "typescript": "~5.8.3",
    "unocss": "^66.6.6",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "8.2.2",
    "vite-auto-i18n-plugin": "^1.1.16",
    "vite-console-plugin": "^2.0.15",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vue-tsc": "^3.2.6"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "oxlint --max-warnings 0 --deny-warnings",
      "eslint --fix --no-cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@hono/node-server": "1.19.15",
    "@xmldom/xmldom": "0.8.13",
    "axios": "1.20.0",
    "body-parser": "2.3.0",
    "defu": "6.1.7",
    "dompurify": "3.4.14",
    "fast-uri": "3.1.5",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "hono": "4.13.5",
    "ip-address": "10.7.0",
    "immutable": "5.1.9",
    "js-yaml": "5.4.1",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimist": "1.2.8",
    "postcss": "8.5.26",
    "protocol-buffers-schema": "3.6.1",
    "qs": "6.16.0",
    "tmp": "0.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.0"
  }
}
