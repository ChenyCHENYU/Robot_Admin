#* 测试环境

# Environmental variable
VITE_APP_ENV = test
VITE_AUTH_MODE = mock
VITE_DATA_MODE = mock
VITE_ROUTER_MODE = hash

# Interface request address
VITE_API_BASE = /api
VITE_ANALYTICS_ENABLED=false
VITE_ROUTE_IDLE_PREFETCH=false

# ========== i18n 翻译配置 ==========
# 测试环境启用翻译（使用已生成的 lang/index.json）
VITE_I18N_ENABLED=false

# 测试环境不需要真实 API 密钥
YOUDAO_APP_ID=
YOUDAO_APP_KEY=
