#* 生产环境

# Environmental variable
VITE_APP_ENV = production
VITE_AUTH_MODE = remote
VITE_DATA_MODE = remote
VITE_ROUTER_MODE = hash

# # Interface request address
VITE_API_BASE = /api
VITE_ANALYTICS_ENABLED=false
VITE_ROUTE_IDLE_PREFETCH=false

# ========== i18n 翻译配置 ==========
# 生产构建无需 i18n 插件（运行时由 lang/index.js 提供 $t，插件只在开发时扫描/翻译）
VITE_I18N_ENABLED=false

# 生产环境不需要真实 API 密钥（buildToDist 只需要插件启用即可）
YOUDAO_APP_ID=
YOUDAO_APP_KEY=
