#* 生产环境

# Environmental variable
VITE_APP_ENV = production
VITE_DEPLOYMENT_PROFILE = demo
VITE_AUTH_MODE = mock
VITE_DATA_MODE = mock
VITE_ROUTER_MODE = hash

# # Interface request address
VITE_API_BASE = /api
VITE_ANALYTICS_ENABLED=false
VITE_ROUTE_IDLE_PREFETCH=true

# ========== i18n 翻译配置 ==========
# 已有词典的编译与语言切换始终可用；此开关只控制联网生成新翻译
VITE_I18N_ENABLED=false

# 已有词典离线编译；生产构建不需要翻译 API 密钥
YOUDAO_APP_ID=
YOUDAO_APP_KEY=
