#* 开发环境

# Environmental variable
VITE_APP_ENV = development
VITE_AUTH_MODE = mock
VITE_DATA_MODE = mock
VITE_ROUTER_MODE = hash

# Interface request address
VITE_API_BASE = /api
VITE_ANALYTICS_ENABLED=false
VITE_ROUTE_IDLE_PREFETCH=false

# ========== i18n 自动翻译配置 ==========
VITE_I18N_ENABLED=false

# 有道翻译 API 凭据只允许放在未跟踪的本地环境中，且不得使用 VITE_ 前缀暴露给客户端
YOUDAO_APP_ID=
YOUDAO_APP_KEY=
